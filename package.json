{
  "name": "pi-tiny-replay",
  "version": "0.1.0",
  "description": "Replay assistant messages natively across compatible Pi models",
  "type": "module",
  "keywords": ["pi-package"],
  "license": "MIT",
  "files": ["README.md", "extensions", "src"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spoj/pi-tiny-replay.git"
  },
  "pi": {
    "extensions": ["./extensions/replay.ts"]
  },
  "scripts": {
